# Copy to .env and replace these placeholders with your PostgreSQL credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kjbn?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Request-scoped reviewer clock; disabled by default.
REVIEW_MODE=false
# Deployment launcher: explicitly ensure the additive fictional seed on startup.
SEED_DEMO_DATA=false
